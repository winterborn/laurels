# Copy to spike/.env and fill in. Never commit spike/.env.

# Your server on the LAN. Use http:// with the IP to avoid certificate errors.
PLEX_URL=http://192.168.1.10:32400

# The server OWNER's token (see SPIKE.md, step 1).
PLEX_TOKEN=

# Optional: only if you already run Tautulli.
TAUTULLI_URL=
TAUTULLI_KEY=

# Films and episodes to sample for metadata checks.
SPIKE_SAMPLE=40
